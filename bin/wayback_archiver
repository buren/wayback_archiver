#!/usr/bin/env ruby

require 'optparse'
require 'shellwords'
require 'set'
require 'wayback_archiver'
require 'wayback_archiver/session_file'

# Default values
urls = nil
strategy = nil
file_path = nil
log = STDOUT
log_level = Logger::INFO
concurrency = WaybackArchiver.concurrency
limit = WaybackArchiver.max_limit
hosts = []
options = {}
show_summary = true
report_path = nil
session_path = nil
no_session = false
resume_path = nil

optparse = OptionParser.new do |parser|
  parser.banner = 'Usage: wayback_archiver [<url>] [options]'

  parser.separator ''
  parser.separator 'Strategy options:'

  parser.on('--auto', 'Auto (default)') do |value|
    strategy = 'auto'
  end

  parser.on('--crawl', 'Crawl') do |value|
    strategy = 'crawl'
  end

  parser.on('--sitemap', 'Sitemap') do |value|
    strategy = 'sitemap'
  end

  parser.on('--urls', '--url', 'URL(s)') do |value|
    strategy = 'urls'
  end

  parser.on('--rss', 'RSS/Atom feed') do |value|
    strategy = 'rss'
  end

  parser.on('--hosts=[example.com]', Array, 'Only spider links on certain hosts') do |value|
    if value
      hosts = value.map do |v|
        Regexp.new(v)
      rescue RegexpError => e
        raise ArgumentError, "Invalid host pattern '#{v}': #{e.message}"
      end
    end
  end

  parser.on('--concurrency=N', Integer, 'Concurrency (default: 4)') do |value|
    raise ArgumentError, "Concurrency must be > 0, got #{value}" unless value > 0

    concurrency = value
  end

  parser.on('--limit=N', Integer, 'Max number of URLs to archive') do |value|
    raise ArgumentError, "Limit must be -1 (unlimited) or > 0, got #{value}" unless value == -1 || value > 0

    limit = value
  end

  parser.separator ''
  parser.separator 'Authentication (get keys at https://archive.org/account/s3.php):'

  parser.on('--access-key=KEY', String, 'Internet Archive S3 access key') do |value|
    WaybackArchiver.access_key = value
  end

  parser.on('--secret-key=KEY', String, 'Internet Archive S3 secret key') do |value|
    WaybackArchiver.secret_key = value
  end

  parser.separator ''
  parser.separator 'SPN2 capture options:'

  parser.on('--capture-all', 'Capture error pages (HTTP 4xx/5xx)') do
    options[:capture_all] = true
  end

  parser.on('--capture-outlinks', 'Auto-capture linked pages (up to 100, requires auth)') do
    options[:capture_outlinks] = true
  end

  parser.on('--capture-screenshot', 'Generate PNG screenshot of the page') do
    options[:capture_screenshot] = true
  end

  parser.on('--screenshot-dir=PATH', String, 'Save screenshots locally (requires auth + --capture-screenshot)') do |value|
    options[:screenshot_dir] = value
  end

  parser.on('--force-get', 'Force HTTP GET instead of HEAD+browser') do
    options[:force_get] = true
  end

  parser.on('--skip-first-archive', 'Skip initial duplicate check (faster)') do
    options[:skip_first_archive] = true
  end

  parser.on('--delay-wb-availability', 'Delay public availability ~12h') do
    options[:delay_wb_availability] = true
  end

  parser.on('--if-not-archived-within=TIMEDELTA', String, 'Skip if recent snapshot exists (e.g. "3d 5h 20m")') do |value|
    options[:if_not_archived_within] = value
  end

  parser.on('--js-behavior-timeout=N', Integer, 'Run JS for N seconds after page load (max 30)') do |value|
    raise ArgumentError, "js-behavior-timeout must be between 1 and 30, got #{value}" unless value.between?(1, 30)

    options[:js_behavior_timeout] = value
  end

  parser.on('--use-user-agent=AGENT', String, 'Custom User-Agent for target page') do |value|
    options[:use_user_agent] = value
  end

  parser.separator ''
  parser.separator 'Input options:'

  parser.on('-f', '--file=PATH', String, 'Read URLs from file (one per line, "-" for stdin)') do |value|
    file_path = value
  end

  parser.separator ''
  parser.separator 'Session options:'

  parser.on('--session=PATH', String, 'Write session file to PATH (default: auto-generated in /tmp)') do |value|
    session_path = value
  end

  parser.on('--no-session', 'Disable session file') do
    no_session = true
  end

  parser.on('--resume=PATH', String, 'Resume from a previous session file') do |value|
    resume_path = value
  end

  parser.separator ''
  parser.separator 'General options:'

  parser.on('--log=output.log', String, 'Path to desired log file (defaults to STDOUT)') do |path|
    log = path
  end

  parser.on('--[no-]verbose', 'Verbose logs') do |value|
    log_level = value ? Logger::DEBUG : Logger::WARN
  end

  parser.on('--quiet', 'Suppress all log output') do
    log_level = Logger::FATAL
  end

  parser.on('--[no-]summary', 'Print summary after archiving (default: true)') do |value|
    show_summary = value
  end

  parser.on('--report=PATH', String, 'Write report to file (CSV or JSON, detected from extension)') do |value|
    report_path = value
  end

  parser.on_tail('-h', '--help', 'Show this message') do
    puts parser
    exit
  end

  parser.on_tail('--version', 'Show version') do
    puts "WaybackArchiver version #{WaybackArchiver::VERSION}"
    exit
  end
end

optparse.parse!

if resume_path && session_path
  raise ArgumentError, "--resume and --session are mutually exclusive"
end

if resume_path && no_session
  raise ArgumentError, "--resume and --no-session are mutually exclusive"
end

if resume_path && !File.exist?(resume_path)
  raise ArgumentError, "Session file not found: #{resume_path}"
end

urls = ARGV.map(&:strip).reject(&:empty?)

if file_path
  # "-" is a Unix convention meaning "read from stdin" — allows piping,
  # e.g.: cat urls.txt | wayback_archiver --file=-
  lines = if file_path == '-'
            $stdin.readlines
          else
            begin
              File.readlines(file_path)
            rescue Errno::ENOENT
              raise ArgumentError, "File not found: #{file_path}"
            rescue Errno::EACCES
              raise ArgumentError, "File not readable: #{file_path}"
            end
          end

  file_urls = lines
    .map(&:strip)
    .reject(&:empty?)
    .reject { |line| line.start_with?('#') }

  urls.concat(file_urls)
  urls.uniq!

  # When --file is used, the intent is "archive these URLs" — default to
  # the :urls strategy unless the user explicitly chose a different one
  strategy ||= 'urls'
end

if urls.empty?
  puts optparse.help
  raise ArgumentError, "[<url>] or --file is required"
end

WaybackArchiver.logger = Logger.new(log).tap do |logger|
  logger.progname = 'WaybackArchiver'
  logger.level = log_level
end

# If no strategy has explicitly been given, then default to 'auto'
strategy ||= 'auto'

build_resume_command = lambda do |session_file|
  parts = ['wayback_archiver']
  if file_path
    parts << "--file=#{Shellwords.shellescape(file_path)}"
  else
    urls.each { |u| parts << Shellwords.shellescape(u) }
  end
  parts << "--resume=#{Shellwords.shellescape(session_file.path)}"
  parts << "--#{strategy}"
  parts << "--concurrency=#{concurrency}" if concurrency != WaybackArchiver::DEFAULT_CONCURRENCY
  parts << "--limit=#{limit}" if limit != WaybackArchiver::DEFAULT_MAX_LIMIT
  hosts.each { |h| parts << "--hosts=#{Shellwords.shellescape(h.source)}" } if hosts.any?
  options.each do |key, value|
    flag = key.to_s.tr('_', '-')
    if value == true
      parts << "--#{flag}"
    elsif value
      parts << "--#{flag}=#{value}"
    end
  end
  parts.join(' ')
end

session = nil
auto_generated_session = false

unless no_session
  if resume_path
    session = WaybackArchiver::SessionFile.new(resume_path)
    WaybackArchiver.logger.info("Resuming from session: #{session.path}")
  elsif session_path
    session = WaybackArchiver::SessionFile.new(session_path)
    WaybackArchiver.logger.info("Session file: #{session.path}")
  else
    session = WaybackArchiver::SessionFile.new(WaybackArchiver::SessionFile.auto_path)
    auto_generated_session = true
    WaybackArchiver.logger.info("Session file: #{session.path}")
  end
end

at_exit { session&.close }

skip_urls = session&.completed_urls
if resume_path && skip_urls&.any?
  WaybackArchiver.logger.info("Session contains #{skip_urls.size} previously succeeded URL(s)")
end

# Pre-compute so the signal handler only does simple string I/O
resume_command = session ? build_resume_command.call(session) : nil

if resume_command
  Signal.trap('INT') do
    $stderr.puts "\nInterrupted. Resume with:"
    $stderr.puts "  #{resume_command}"
    exit(1)
  end
end

all_results = urls.flat_map do |url|
  WaybackArchiver.archive(
    url,
    hosts: hosts,
    strategy: strategy,
    concurrency: concurrency,
    limit: limit,
    skip_urls: skip_urls,
    **options
  ) do |result|
    session&.write_result(result)
  end
end

if report_path
  require 'wayback_archiver/report'
  WaybackArchiver::Report.write(all_results, report_path)
  WaybackArchiver.logger.info("Report written to #{report_path}")
end

if session
  if all_results.any?(&:errored?)
    $stderr.puts "Some URLs failed. Resume with:"
    $stderr.puts "  #{resume_command}"
  elsif auto_generated_session
    session.delete!
    session = nil
  end
end

if show_summary
  succeeded = all_results.count(&:success?)
  failed = all_results.count(&:errored?)
  total = all_results.length
  total_duration = all_results.sum { |r| r.duration_sec || 0 }.round(1)

  puts "\n--- Summary ---"
  puts "Total: #{total}  Succeeded: #{succeeded}  Failed: #{failed}"
  puts "Duration: #{total_duration}s"
end
